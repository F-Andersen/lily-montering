APP_ENV=local
APP_URL=http://localhost:8080
# Local default. Production: choose a private, unique path and mirror it in Nginx.
ADMIN_PATH=adfiksittmin
# Exact ingress IPs only; never trust arbitrary client scheme headers.
TRUSTED_PROXIES=
# Production compose binds privately; use the actual ingress bridge address.
WEB_BIND_IP=127.0.0.1
INGRESS_BIND_IP=127.0.0.1
INGRESS_PORT=18080
# cPanel: set a writable directory OUTSIDE public_html in config.php.
# Docker uses the persistent private request_photos volume by default.
REQUEST_PHOTO_DIR=/var/lib/fiksitt/request-photos
WEB_PORT=8080
MAILPIT_PORT=8025
DB_HOST=db
DB_PORT=3306
DB_NAME=lily
DB_USER=lily
DB_PASSWORD=local-development-only
DB_ROOT_PASSWORD=local-root-development-only
SMTP_HOST=mailpit
SMTP_PORT=1025
# Generate your own token; no default admin credentials exist.
SETUP_TOKEN=
